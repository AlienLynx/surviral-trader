# One line-ending policy for the whole repo: text files are stored AND checked out with LF, on every OS.
# Without this, Windows checkouts (core.autocrlf=true) show CRLF working copies and "LF will be replaced by CRLF" noise.
* text=auto eol=lf

# Files that must never be converted (shell scripts and Dockerfiles run in Linux containers; a CR breaks them).
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary artefacts
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.safetensors binary
*.sqlite binary
*.sqlite-shm binary
*.sqlite-wal binary
