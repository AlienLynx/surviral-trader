{
  "max_open_trades": 10,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "dry_run": true,
  "dry_run_wallet": 500,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      ".*/USDT"
    ],
    "pair_blacklist": [
      "USDC/USDT",
      "DAI/USDT",
      "TUSD/USDT",
      "FDUSD/USDT",
      "USDE/USDT",
      ".*UP/USDT",
      ".*DOWN/USDT",
      ".*BULL/USDT",
      ".*BEAR/USDT",
      ".*3L/USDT",
      ".*3S/USDT"
    ]
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 15,
      "sort_key": "quoteVolume",
      "min_value": 0,
      "refresh_period": 3600
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.01
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    },
    {
      "method": "VolatilityFilter",
      "lookback_days": 3,
      "min_volatility": 0.01,
      "max_volatility": 0.75,
      "refresh_period": 3600
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "set-via-FREQTRADE_API_JWT_SECRET-in-credentials-panel",
    "CORS_origins": [],
    "username": "set-via-credentials-panel",
    "password": "set-via-credentials-panel"
  },
  "bot_name": "survival-agent-freqtrade",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  }
}