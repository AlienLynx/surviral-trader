# Environment variables of the survival-agent stack, ready to import into Portainer (Stacks -> your stack -> Environment variables -> Load variables from .env file).
# Every ${VAR} that docker-compose.yml reads is here, with the default the compose file uses when the variable is not set (an empty value = off / not configured).
# Secrets (keys, secrets, the Freqtrade password and JWT secret) are EMPTY: fill them in. Nothing secret belongs in git.
# Descriptions of every variable: ENVIRONMENT_VARIABLES.md.

# ----------------------------------------------------------------------
# LLM keys (all optional except DEEPSEEK_API_KEY for the LLM bots; leave empty to disable a provider)
# ----------------------------------------------------------------------
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
KILO_API_KEY=
AION_API_KEY=
AGNES_API_KEY=
NVIDIA_API_KEY=
LLM7_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------------
# Decision source of Main / Shorts / Moonshot (P23).  SOURCE: llm = the LLM alone (the old behaviour) | kronos_llm = Kronos proposes, the LLM may confirm or veto (default) | kronos = Kronos alone, no LLM veto.
# PROVIDER: deepseek (default) | free (OpenRouter free models only) | none (the LLM is never called). See ENVIRONMENT_VARIABLES.md.
# ----------------------------------------------------------------------
MAIN_DECISION_SOURCE=kronos_llm
MAIN_LLM_PROVIDER=deepseek
SHORTS_DECISION_SOURCE=kronos_llm
SHORTS_LLM_PROVIDER=deepseek
MOONSHOT_DECISION_SOURCE=kronos_llm
MOONSHOT_LLM_PROVIDER=deepseek

# ----------------------------------------------------------------------
# Kronos (the forecaster container and the rank that feeds the bots)
# ----------------------------------------------------------------------
KRONOS_MODE=on
KRONOS_MAX_PAIRS=45
KRONOS_CYCLE_BUDGET_S=900
KRONOS_RANK_MIN_N=8
KRONOS_RANK_MIN_SCORE=0.003
KRONOS_THRESHOLD=0.005
KRONOS_SAMPLES=3
KRONOS_SKIP_BOTS=

# ----------------------------------------------------------------------
# Freqtrade REST API (the dashboard reads every bot with these; choose any values, they must be the same everywhere)
# ----------------------------------------------------------------------
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
FREQTRADE_API_JWT_SECRET=
FREQTRADE_UI_HOST=localhost

# ----------------------------------------------------------------------
# Dry-run paper money per bot (keep equal to the capital ledger of that bot) and max open trades per bot
# ----------------------------------------------------------------------
MAIN_DRY_RUN_WALLET=500
SHORTS_DRY_RUN_WALLET=500
MOONSHOT_DRY_RUN_WALLET=100
FADE_DRY_RUN_WALLET=100
TREND_DRY_RUN_WALLET=100
TREND_V2_DRY_RUN_WALLET=500
CONTROL_LONG_DRY_RUN_WALLET=500
CONTROL_SHORT_DRY_RUN_WALLET=500
MAIN_MAX_OPEN_TRADES=10
SHORTS_MAX_OPEN_TRADES=10
MOONSHOT_MAX_OPEN_TRADES=10
FADE_MAX_OPEN_TRADES=3
TREND_MAX_OPEN_TRADES=10
TREND_V2_MAX_OPEN_TRADES=10

# ----------------------------------------------------------------------
# Dry-run / live switches. Everything stays DRY-RUN until you set these on purpose (the rule bots also need their *_LIVE_MODE=true).
# ----------------------------------------------------------------------
FREQTRADE__DRY_RUN=
FREQTRADE_SHORTS__DRY_RUN=
FREQTRADE_MOONSHOT__DRY_RUN=
FREQTRADE_LISTING_FADE__DRY_RUN=true
FREQTRADE_TREND__DRY_RUN=true
FREQTRADE_TREND_V2__DRY_RUN=
FADE_LIVE_MODE=false
TREND_LIVE_MODE=false
TREND_V2_LIVE_MODE=false

# ----------------------------------------------------------------------
# Exchange keys (Bybit). Only needed for live trading; dry-run uses public data. Use sub-accounts with withdrawals disabled.
# ----------------------------------------------------------------------
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SHORTS_API_KEY=
BYBIT_SHORTS_API_SECRET=
BYBIT_MOONSHOT_API_KEY=
BYBIT_MOONSHOT_API_SECRET=
BYBIT_FADE_API_KEY=
BYBIT_FADE_API_SECRET=
BYBIT_TREND_API_KEY=
BYBIT_TREND_API_SECRET=
BYBIT_TREND_V2_API_KEY=
BYBIT_TREND_V2_API_SECRET=

# ----------------------------------------------------------------------
# Portfolio brain, allocator, signal audit. PORTFOLIO_BRAIN_MODE: off | shadow (compute and log, touch no bot) | enforce (the allocator scales stakes and can pause bots). Also switchable on the dashboard (Portfolio tab).
# ----------------------------------------------------------------------
PORTFOLIO_BRAIN_MODE=enforce
ALLOCATOR_POLICY=grow
RANKER_MODE=off
ALLOCATOR_BREAKER=on
ALLOCATOR_BREAKER_STAKES=1.25
ALLOCATOR_BREAKER_STREAK=8
FADE_REENTRY_COOLDOWN_H=24
SIGNAL_AUDIT_MODE=on
MARKET_CONTEXT_MODE=on
ALLOCATOR_EXCLUDED_BOTS=
ALLOCATOR_RETIRED_BOTS=
ALLOCATOR_RETIRED_FROZEN=
ALLOCATOR_PROBE=on
ALLOCATOR_PROBE_DAYS=7
ALLOCATOR_COIN_LIMIT=0.25
PORTFOLIO_FLOOR_PCT=0.90
CPPI_MULTIPLIER=3
TARGET_MONTHLY_PCT=1.0
TARGET_WEEKLY_PCT=0.25

# ----------------------------------------------------------------------
# Survival / payout accounting
# ----------------------------------------------------------------------
SURVIVAL_MONTHLY_USD=60
SURVIVAL_RUNWAY_MONTHS=4
SURVIVAL_MODE=grow
SURVIVAL_TARGET_MONTHLY_USD=1000

# ----------------------------------------------------------------------
# Shadow second-opinion ensemble (logs a vote, never changes a decision)
# ----------------------------------------------------------------------
FREQTRADE_SECOND_OPINION_ENABLED=false
FREQTRADE_SHORTS_SECOND_OPINION_ENABLED=false
FREQTRADE_MOONSHOT_SECOND_OPINION_ENABLED=false

# ----------------------------------------------------------------------
# Replay limits and prices (the /replay page; DeepSeek prices are needed before a paid replay can start)
# ----------------------------------------------------------------------
REPLAY_MAX_USD=
REPLAY_WORKERS=
REPLAY_MIN_START=
REPLAY_PRICE_IN_PER_M=
REPLAY_PRICE_OUT_PER_M=
REPLAY_FEE_PCT=
REPLAY_SLIPPAGE_PCT=

# ----------------------------------------------------------------------
# Replay with a second, free model (smoke tests only; REPLAY_LLM_RPM and REPLAY_LLM_DAILY_CAP are mandatory with it)
# ----------------------------------------------------------------------
REPLAY_LLM_PROVIDER=
REPLAY_LLM_BASE_URL=
REPLAY_LLM_MODEL=
REPLAY_LLM_API_KEY=
REPLAY_LLM_RPM=
REPLAY_LLM_DAILY_CAP=
REPLAY_LLM_PRICE_IN_PER_M=
REPLAY_LLM_PRICE_OUT_PER_M=
